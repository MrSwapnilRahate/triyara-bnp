# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth (required at runtime) ----
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret
AUTH_TRUST_HOST=true

# ---- Database ----
DATABASE_URL=postgresql://triyara:triyara@localhost:5432/triyara_bnp

