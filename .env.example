# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Auth (required at runtime) ----
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret
AUTH_TRUST_HOST=true

# ---- Database ----
DATABASE_URL=postgresql://triyara:triyara@localhost:5432/triyara_bnp

# ---- Storage (documents) ----
# Default provider is "local" (filesystem; zero-config, works with `pnpm dev`).
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=.storage
# STORAGE_SECRET=change-me-for-signed-local-urls
#
# For cloud, set STORAGE_PROVIDER=s3 or r2 and fill:
# STORAGE_REGION=auto
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
