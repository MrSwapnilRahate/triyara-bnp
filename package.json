{
  "name": "triyara-bnp",
  "version": "0.0.0",
  "private": true,
  "description": "Triyara Exports LLP - Business Network Platform (monorepo)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "pnpm --filter @triyara/db db:migrate",
    "db:seed": "pnpm --filter @triyara/db db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.5.22",
    "@playwright/test": "^1.62.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.2.1",
    "turbo": "^2.10.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma"
  }
}
