{
  "name": "@triyara/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo dist",
    "test": "vitest run",
    "db:bootstrap-admin": "tsx prisma/bootstrap-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@triyara/auth": "workspace:*",
    "@triyara/lib": "workspace:*"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "prisma": "^6.2.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "@types/node": "^22.10.5"
  }
}
