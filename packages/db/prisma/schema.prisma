// Identity (TRY-BNP-AUTH-01) + Account aggregate (TRY-BNP-ACCOUNT-01).
// Only entities implemented to date. Business sub-entities (Supplier/Buyer profiles,
// Contacts, Addresses, Documents, Verification) are logical in TRY-BNP-DB-01 and land
// with their own modules. Account is the aggregate root every future module extends.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleName {
  ADMIN
  EXPORT_MANAGER
  VERIFIER
  READ_ONLY
}

enum RelationshipStatus {
  PROSPECT
  ACTIVE
  PREFERRED
  DORMANT
  BLACKLISTED
}

enum ManufacturingType {
  MANUFACTURER
  PROCESSOR
  TRADER
  FARMER_PRODUCER
  CONTRACT_MANUFACTURER
  OTHER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  accounts Account[]

  // Product Catalog (TRY-BNP-CATALOG-S1) back-relations. ORM-side only:
  // these add NO columns to the Organization table.
  categories      Category[]
  products        Product[]
  specDefinitions ProductSpecificationDefinition[]
  tags            Tag[]
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  name           String
  passwordHash   String
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  resetTokens   PasswordResetToken[]
  ownedAccounts Account[]            @relation("AccountOwner")

  @@index([organizationId])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The canonical Partner record. Aggregate root (TRY-BNP-DB-01).
model Account {
  id                 String             @id @default(cuid())
  organizationId     String
  legalName          String
  displayName        String?
  country            String? // ISO 3166 alpha-2; future FK to a Country reference table
  relationshipStatus RelationshipStatus @default(PROSPECT)
  source             String?
  ownerId            String?
  createdById        String
  updatedById        String
  deletedById        String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?            @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  supplierProfile SupplierProfile?
  buyerProfile    BuyerProfile?

  @@index([organizationId, deletedAt])
  @@index([organizationId, relationshipStatus])
  @@index([organizationId, legalName])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

// Immutable change log (TRY-BNP-DB-01). Written on every governed mutation.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  actorId        String
  action         String
  before         Json?
  after          Json?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

// 1:1 extension of Account. Account owns identity; SupplierProfile owns supplier
// capabilities (TRY-BNP-SUPPLIER-01 / TRY-BNP-EXT-01). accountId is unique -> exactly
// one profile per account. Cannot exist without its Account (cascade).
model SupplierProfile {
  id             String @id @default(cuid())
  accountId      String @unique
  organizationId String

  manufacturingType     ManufacturingType?
  businessType          String?
  factorySizeSqm        Int?
  employees             Int?
  productionCapacity    String?
  annualTurnoverBand    String?
  exportExperienceYears Int?

  primaryMarkets     String[]
  exportCountries    String[]
  languages          String[]
  incoterms          String[]
  paymentTerms       String[]
  supportedDocuments String[]
  certifications     String[]

  leadTimeDays Int?
  moq          String?
  packaging    String?

  oem          Boolean @default(false)
  odm          Boolean @default(false)
  privateLabel Boolean @default(false)

  website     String?
  socialLinks Json?
  description String?

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products SupplierProduct[]

  @@index([organizationId, deletedAt])
}

// Supplier x Product capability (EXT-01 capability-matrix seed). Product is a code/name
// until a Product master table lands.
model SupplierProduct {
  id                String   @id @default(cuid())
  supplierProfileId String
  product           String
  capacityPerMonth  String?
  moq               String?
  leadTimeDays      Int?
  createdAt         DateTime @default(now())

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, product])
  @@index([supplierProfileId])
}

enum DocumentType {
  GST
  IEC
  FSSAI
  APEDA
  ISO
  HACCP
  BRC
  FACTORY_LICENSE
  COMPANY_REGISTRATION
  IMPORT_EXPORT_LICENSE
  PAN
  MSME
  PRODUCT_CATALOGUE
  COMPANY_PROFILE
  OTHER
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
  EXPIRED
  REJECTED
}

// Document attached to an Account (and optionally a SupplierProfile). Owners are
// referenced by plain ID (no Prisma relation) so the FROZEN Account/SupplierProfile
// models are not modified at all; referential integrity + org isolation are enforced
// in the service layer. Binary files are never overwritten - each replacement adds a
// DocumentVersion; current-file metadata is denormalized here for list/detail (no N+1).
model Document {
  id                String  @id @default(cuid())
  organizationId    String
  accountId         String
  supplierProfileId String?

  type   DocumentType
  status DocumentStatus @default(PENDING)
  title  String

  issuedDate DateTime?
  expiryDate DateTime?

  currentFileVersion      Int    @default(1)
  currentStorageKey       String
  currentMimeType         String
  currentOriginalFilename String
  currentFileSize         Int
  currentChecksum         String

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions DocumentVersion[]

  @@index([organizationId, accountId, deletedAt])
  @@index([organizationId, supplierProfileId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, expiryDate])
  @@index([organizationId, currentChecksum])
}

// Immutable file-revision history. Every replacement creates a new row with its own
// storageKey; prior binaries are preserved.
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  versionNumber    Int
  storageKey       String
  mimeType         String
  originalFilename String
  fileSize         Int
  checksum         String
  uploadedById     String
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  DOCUMENTS_REQUESTED
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

enum VerificationItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A supplier verification attempt. Consumes SupplierProfile + Documents by ID ONLY -
// it never stores files and holds no Prisma relations to the frozen Account / User /
// SupplierProfile / Document models (all references are plain IDs). One supplier may
// have many attempts; only one may be "active" (enforced in the service).
model Verification {
  id                    String                @id @default(cuid())
  organizationId        String
  accountId             String
  supplierProfileId     String?
  status                VerificationStatus    @default(DRAFT)
  decision              VerificationDecision?
  reason                String?
  reviewerId            String?
  requiredDocumentTypes String[]
  submittedAt           DateTime?
  decidedAt             DateTime?
  expiresAt             DateTime?
  version               Int                   @default(1)
  createdById           String
  updatedById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reviews VerificationReview[]
  notes   VerificationNote[]
  history VerificationHistory[]

  @@index([organizationId, accountId])
  @@index([organizationId, status])
  @@index([organizationId, reviewerId])
}

// Per-document checklist item. References a Document by ID; documentType is denormalized
// for the required-documents checklist. No relation to the frozen Document model.
model VerificationReview {
  id             String                 @id @default(cuid())
  verificationId String
  documentId     String
  documentType   String
  status         VerificationItemStatus @default(PENDING)
  note           String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, documentId])
  @@index([verificationId])
}

model VerificationNote {
  id             String   @id @default(cuid())
  verificationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

// Immutable state-transition / decision history (never edited or deleted).
model VerificationHistory {
  id             String              @id @default(cuid())
  verificationId String
  fromStatus     VerificationStatus?
  toStatus       VerificationStatus
  action         String
  actorId        String
  reason         String?
  createdAt      DateTime            @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  RESTORED
  ASSIGNED
  UPLOADED
  APPROVED
  REJECTED
  REQUESTED
  DOWNLOADED
  STATUS_CHANGED
  OTHER
}

// Append-only activity feed built by consuming domain events (account.* / supplier.* /
// document.* / verification.* and any future module). References entities/actors by plain
// ID only - no relations to the frozen models. metadata (ActivityMetadata) is the raw
// event payload.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  accountId      String?
  actorId        String?
  actorType      String
  entityType     String
  entityId       String?
  eventName      String
  activityType   ActivityType
  description    String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, entityType])
  @@index([organizationId, actorId])
  @@index([organizationId, activityType])
}

enum NotificationType {
  ACCOUNT
  SUPPLIER
  DOCUMENT
  VERIFICATION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A notification message projected from a consumed domain event (never emits events).
// Fans out to one NotificationRecipient per user. References frozen entities/actors by
// plain ID only.
model Notification {
  id             String               @id @default(cuid())
  organizationId String
  type           NotificationType
  priority       NotificationPriority @default(NORMAL)
  actorId        String?
  entityType     String?
  entityId       String?
  accountId      String?
  eventName      String
  title          String
  body           String
  metadata       Json?
  createdAt      DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([organizationId, createdAt])
}

// Per-user copy: read/archived state lives here (recipient isolation).
model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  recipientId    String
  organizationId String
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, recipientId])
  @@index([organizationId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, archivedAt])
}

// Per-channel delivery record. In-app is delivered immediately; email/webhook/push are
// queued for a future dispatcher (interface only).
model NotificationDelivery {
  id             String              @id @default(cuid())
  recipientRowId String
  channel        NotificationChannel
  status         NotificationStatus  @default(QUEUED)
  attemptedAt    DateTime?
  deliveredAt    DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  recipient NotificationRecipient @relation(fields: [recipientRowId], references: [id], onDelete: Cascade)

  @@index([recipientRowId])
}

// Per user, per notification type. Missing row = default (enabled, in-app).
model NotificationPreference {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  enabled        Boolean               @default(true)
  muted          Boolean               @default(false)
  digest         Boolean               @default(false)
  channels       NotificationChannel[]
  updatedAt      DateTime              @updatedAt

  @@unique([userId, type])
  @@index([organizationId, userId])
}

enum BuyerType {
  IMPORTER
  DISTRIBUTOR
  WHOLESALER
  RETAILER
  FOOD_PROCESSOR
  TRADER
  BRAND
  HORECA
  OTHER
}

enum ImportExperience {
  NEW
  YEARS_1_3
  YEARS_3_PLUS
}

// 1:1 buyer extension of Account. Account owns identity; BuyerProfile owns buyer demand.
// Account is FROZEN, so accountId is a plain unique reference (no Prisma relation / no
// back-relation on Account); the 1:1 is enforced by the unique key + the service.
model BuyerProfile {
  id             String @id @default(cuid())
  accountId      String @unique
  organizationId String

  businessType           BuyerType?
  annualRequirement      String?
  annualBudgetBand       String?
  importExperience       ImportExperience?
  destinationCountries   String[]
  destinationPort        String?
  incoterms              String[]
  paymentTerms           String[]
  certificationsRequired String[]
  languages              String[]

  website     String?
  socialLinks Json?
  description String?

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products BuyerProduct[]

  @@index([organizationId, deletedAt])
}

// A product the buyer wants to source (demand seed for EXT-01 intent modelling).
model BuyerProduct {
  id             String   @id @default(cuid())
  buyerProfileId String
  product        String
  targetVolume   String?
  targetPrice    String?
  frequency      String?
  createdAt      DateTime @default(now())

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)

  @@unique([buyerProfileId, product])
  @@index([buyerProfileId])
}

// ===========================================================================
// PRODUCT CATALOG (TRY-BNP-CATALOG-S1)
//
// Central master data. Every future module (Supplier, Buyer, Quotation, Order,
// Inventory) references Product by id and never modifies it. Uniqueness is
// always tenant-scoped; money is always Decimal; deletes are soft.
// ===========================================================================

/// Editorial + commercial lifecycle of a catalog product.
enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  DISCONTINUED
  ARCHIVED
}

/// Storage type of a specification value. Drives validation and decides which
/// typed projection column on ProductSpecification is populated.
enum DataType {
  STRING
  NUMBER
  BOOLEAN
  DATE
  ENUM
}

/// Role an image plays in a product's media set.
enum ImageType {
  PRIMARY
  GALLERY
  THUMBNAIL
  PACKAGING
  LABEL
}

/// PRODUCT-level document classes. Deliberately separate from the frozen
/// Documents module's COMPANY-level `DocumentType` (GST, IEC, APEDA, HACCP...).
enum ProductDocumentType {
  COA
  MSDS
  SPEC_SHEET
  ISO_CERTIFICATE
  FSSAI
  HALAL
  KOSHER
  LAB_REPORT
  ORGANIC_CERTIFICATE
  PHYTOSANITARY
  CERTIFICATE_OF_ORIGIN
  OTHER
}

/// Incoterms 2020 - all eleven rules.
enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

/// Product classification with unlimited nesting (adjacency list + path).
model Category {
  id             String @id @default(cuid())
  organizationId String

  parentId    String?
  name        String
  slug        String
  description String?

  /// Denormalised ancestry maintained by the service on create/move, e.g.
  /// "/spices/whole-spices/turmeric". Turns subtree reads into an indexed
  /// LIKE instead of a recursive CTE.
  path  String
  /// Root = 0. Denormalised depth for breadcrumbs and max-depth guards.
  depth Int    @default(0)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId, sortOrder])
  @@index([organizationId, path])
  @@index([organizationId, isActive, deletedAt])
}

/// The master product record every other module references.
model Product {
  id             String @id @default(cuid())
  organizationId String

  sku              String
  name             String
  slug             String
  shortDescription String?
  description      String? @db.Text

  categoryId String

  /// ISO 3166-1 alpha-2, e.g. "IN".
  countryOfOrigin String? @db.Char(2)
  brand           String?
  /// HS / HSN tariff code, 6-12 digits, stored unformatted.
  hsCode          String?

  status   ProductStatus @default(DRAFT)
  isActive Boolean       @default(true)

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  specifications ProductSpecification[]
  images         ProductImage[]
  documents      ProductDocument[]
  prices         ProductPrice[]
  tags           ProductTag[]

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@index([organizationId, categoryId, status])
  @@index([organizationId, status, isActive, deletedAt])
  @@index([organizationId, hsCode])
  @@index([organizationId, countryOfOrigin])
  @@index([organizationId, brand])
  @@index([categoryId])
  /// Trigram indexes for fuzzy / substring matching on the two identifiers
  /// users actually type. Declared here rather than in raw SQL so the datamodel
  /// owns them and `migrate diff` does not try to drop them. Requires the
  /// pg_trgm extension, created in migration 0001_catalog_extensions.
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "Product_sku_trgm_idx", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm_idx", type: Gin)
}

/// Definition of a dynamic specification (Moisture, Purity, Curcumin, ...).
model ProductSpecificationDefinition {
  id             String @id @default(cuid())
  organizationId String

  name String
  slug String
  /// Unit the value is expressed in, e.g. "%", "mesh", "months".
  unit String?

  dataType DataType @default(STRING)

  /// Permitted values when dataType = ENUM (e.g. Grade: A, B, C).
  allowedValues String[]

  /// Surfaced as a search facet when true.
  isFilterable Boolean @default(false)
  isRequired   Boolean @default(false)
  sortOrder    Int     @default(0)

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       ProductSpecification[]

  @@unique([organizationId, slug])
  @@index([organizationId, sortOrder])
  @@index([organizationId, isFilterable])
}

/// A specification value for one product (EAV).
model ProductSpecification {
  id           String @id @default(cuid())
  productId    String
  definitionId String

  /// Canonical value exactly as entered. Always populated.
  value String

  /// Typed projections written by the service from `value` according to
  /// definition.dataType, so range filters never cast text. Derived data.
  valueNumber  Decimal?  @db.Decimal(18, 6)
  valueBoolean Boolean?
  valueDate    DateTime?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition ProductSpecificationDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([productId])
  @@index([definitionId, valueNumber])
  @@index([definitionId, value])
}

/// Product imagery. Exactly one PRIMARY per product is enforced by a partial
/// unique index created in the migration (Prisma cannot express it).
model ProductImage {
  id        String @id @default(cuid())
  productId String

  url     String
  altText String?
  type    ImageType @default(GALLERY)

  /// Storage-provider object key when the file is platform-managed.
  storageKey String?
  width      Int?
  height     Int?
  fileSize   Int?
  checksum   String?

  sortOrder Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, sortOrder])
  @@index([productId, deletedAt])
}

/// Export/compliance certificates attached to a product.
model ProductDocument {
  id        String @id @default(cuid())
  productId String

  documentType ProductDocumentType
  title        String?

  fileUrl    String
  storageKey String?
  mimeType   String?
  fileSize   Int?
  checksum   String?

  /// The issuer's own revision label, e.g. "Rev-3". NOT the optimistic
  /// concurrency counter - that is `recordVersion`.
  version    String?
  issuedBy   String?
  issuedAt   DateTime?
  validUntil DateTime?

  /// Whether the document may be shown to unauthenticated buyers.
  isPublic Boolean @default(false)

  /// Seam to the frozen platform Document module. Populated when the file is
  /// also a managed, access-controlled platform document.
  documentId String?

  sortOrder Int @default(0)

  recordVersion Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, documentType])
  @@index([productId, deletedAt])
  @@index([validUntil])
  @@index([documentId])
}

/// Triyara's own export list price. Supplier-specific cost lives in the
/// Supplier module, never here.
model ProductPrice {
  id        String @id @default(cuid())
  productId String

  /// ISO 4217. Never inferred from locale.
  currency String  @db.Char(3)
  /// Exact decimal. Never Float.
  price    Decimal @db.Decimal(18, 4)

  incoterm Incoterm
  /// UN/LOCODE or named place, e.g. "INNSA" / "Nhava Sheva".
  port     String?

  minimumOrderQty Decimal? @db.Decimal(18, 4)
  /// UoM the price and MOQ are quoted in, e.g. "MT", "KG".
  unit            String?

  validFrom DateTime
  validTo   DateTime?

  isActive Boolean @default(true)
  notes    String?

  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, incoterm, port, currency, minimumOrderQty, validFrom])
  @@index([productId, isActive, validFrom, validTo])
  @@index([productId, incoterm])
  @@index([productId, currency])
}

/// Free-form merchandising label (Organic, Premium, Best Seller, ...).
model Tag {
  id             String @id @default(cuid())
  organizationId String

  name        String
  slug        String
  description String?
  /// Presentation hint (hex), e.g. "#0F766E".
  color       String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     ProductTag[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive, sortOrder])
}

/// Product <-> Tag join.
model ProductTag {
  productId String
  tagId     String

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}
