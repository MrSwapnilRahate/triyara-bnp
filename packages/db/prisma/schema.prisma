// Identity (TRY-BNP-AUTH-01) + Account aggregate (TRY-BNP-ACCOUNT-01).
// Only entities implemented to date. Business sub-entities (Supplier/Buyer profiles,
// Contacts, Addresses, Documents, Verification) are logical in TRY-BNP-DB-01 and land
// with their own modules. Account is the aggregate root every future module extends.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleName {
  ADMIN
  EXPORT_MANAGER
  VERIFIER
  READ_ONLY
}

enum RelationshipStatus {
  PROSPECT
  ACTIVE
  PREFERRED
  DORMANT
  BLACKLISTED
}

enum ManufacturingType {
  MANUFACTURER
  PROCESSOR
  TRADER
  FARMER_PRODUCER
  CONTRACT_MANUFACTURER
  OTHER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  accounts Account[]
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String     @unique
  name           String
  passwordHash   String
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles         UserRole[]
  resetTokens   PasswordResetToken[]
  ownedAccounts Account[]            @relation("AccountOwner")

  // Auth extension (TRY-BNP-AUTH-02) back-relations. ORM-side only: these add
  // NO columns to the User table and leave TRY-BNP-AUTH-01 unmodified.
  securityProfile         UserSecurityProfile?
  emailVerificationTokens EmailVerificationToken[]
  sessions                UserSession[]
  scopedRoles             ScopedRoleAssignment[]

  @@index([organizationId])
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?

  users UserRole[]

  // Auth extension (TRY-BNP-AUTH-02) back-relation. Adds no columns to Role.
  scopedAssignments ScopedRoleAssignment[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The canonical Partner record. Aggregate root (TRY-BNP-DB-01).
model Account {
  id                 String             @id @default(cuid())
  organizationId     String
  legalName          String
  displayName        String?
  country            String? // ISO 3166 alpha-2; future FK to a Country reference table
  relationshipStatus RelationshipStatus @default(PROSPECT)
  source             String?
  ownerId            String?
  createdById        String
  updatedById        String
  deletedById        String?
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?            @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  supplierProfile SupplierProfile?
  buyerProfile    BuyerProfile?

  @@index([organizationId, deletedAt])
  @@index([organizationId, relationshipStatus])
  @@index([organizationId, legalName])
  @@index([organizationId, ownerId])
  @@index([organizationId, createdAt])
}

// Immutable change log (TRY-BNP-DB-01). Written on every governed mutation.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  actorId        String
  action         String
  before         Json?
  after          Json?
  requestId      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

// 1:1 extension of Account. Account owns identity; SupplierProfile owns supplier
// capabilities (TRY-BNP-SUPPLIER-01 / TRY-BNP-EXT-01). accountId is unique -> exactly
// one profile per account. Cannot exist without its Account (cascade).
model SupplierProfile {
  id             String @id @default(cuid())
  accountId      String @unique
  organizationId String

  manufacturingType     ManufacturingType?
  businessType          String?
  factorySizeSqm        Int?
  employees             Int?
  productionCapacity    String?
  annualTurnoverBand    String?
  exportExperienceYears Int?

  primaryMarkets     String[]
  exportCountries    String[]
  languages          String[]
  incoterms          String[]
  paymentTerms       String[]
  supportedDocuments String[]
  certifications     String[]

  leadTimeDays Int?
  moq          String?
  packaging    String?

  oem          Boolean @default(false)
  odm          Boolean @default(false)
  privateLabel Boolean @default(false)

  website     String?
  socialLinks Json?
  description String?

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products SupplierProduct[]

  @@index([organizationId, deletedAt])
}

// Supplier x Product capability (EXT-01 capability-matrix seed). Product is a code/name
// until a Product master table lands.
model SupplierProduct {
  id                String   @id @default(cuid())
  supplierProfileId String
  product           String
  capacityPerMonth  String?
  moq               String?
  leadTimeDays      Int?
  createdAt         DateTime @default(now())

  supplierProfile SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)

  @@unique([supplierProfileId, product])
  @@index([supplierProfileId])
}

enum DocumentType {
  GST
  IEC
  FSSAI
  APEDA
  ISO
  HACCP
  BRC
  FACTORY_LICENSE
  COMPANY_REGISTRATION
  IMPORT_EXPORT_LICENSE
  PAN
  MSME
  PRODUCT_CATALOGUE
  COMPANY_PROFILE
  OTHER
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
  EXPIRED
  REJECTED
}

// Document attached to an Account (and optionally a SupplierProfile). Owners are
// referenced by plain ID (no Prisma relation) so the FROZEN Account/SupplierProfile
// models are not modified at all; referential integrity + org isolation are enforced
// in the service layer. Binary files are never overwritten - each replacement adds a
// DocumentVersion; current-file metadata is denormalized here for list/detail (no N+1).
model Document {
  id                String  @id @default(cuid())
  organizationId    String
  accountId         String
  supplierProfileId String?

  type   DocumentType
  status DocumentStatus @default(PENDING)
  title  String

  issuedDate DateTime?
  expiryDate DateTime?

  currentFileVersion      Int    @default(1)
  currentStorageKey       String
  currentMimeType         String
  currentOriginalFilename String
  currentFileSize         Int
  currentChecksum         String

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions DocumentVersion[]

  @@index([organizationId, accountId, deletedAt])
  @@index([organizationId, supplierProfileId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, expiryDate])
  @@index([organizationId, currentChecksum])
}

// Immutable file-revision history. Every replacement creates a new row with its own
// storageKey; prior binaries are preserved.
model DocumentVersion {
  id               String   @id @default(cuid())
  documentId       String
  versionNumber    Int
  storageKey       String
  mimeType         String
  originalFilename String
  fileSize         Int
  checksum         String
  uploadedById     String
  createdAt        DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  DOCUMENTS_REQUESTED
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum VerificationDecision {
  APPROVED
  REJECTED
}

enum VerificationItemStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A supplier verification attempt. Consumes SupplierProfile + Documents by ID ONLY -
// it never stores files and holds no Prisma relations to the frozen Account / User /
// SupplierProfile / Document models (all references are plain IDs). One supplier may
// have many attempts; only one may be "active" (enforced in the service).
model Verification {
  id                    String                @id @default(cuid())
  organizationId        String
  accountId             String
  supplierProfileId     String?
  status                VerificationStatus    @default(DRAFT)
  decision              VerificationDecision?
  reason                String?
  reviewerId            String?
  requiredDocumentTypes String[]
  submittedAt           DateTime?
  decidedAt             DateTime?
  expiresAt             DateTime?
  version               Int                   @default(1)
  createdById           String
  updatedById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  reviews VerificationReview[]
  notes   VerificationNote[]
  history VerificationHistory[]

  @@index([organizationId, accountId])
  @@index([organizationId, status])
  @@index([organizationId, reviewerId])
}

// Per-document checklist item. References a Document by ID; documentType is denormalized
// for the required-documents checklist. No relation to the frozen Document model.
model VerificationReview {
  id             String                 @id @default(cuid())
  verificationId String
  documentId     String
  documentType   String
  status         VerificationItemStatus @default(PENDING)
  note           String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@unique([verificationId, documentId])
  @@index([verificationId])
}

model VerificationNote {
  id             String   @id @default(cuid())
  verificationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

// Immutable state-transition / decision history (never edited or deleted).
model VerificationHistory {
  id             String              @id @default(cuid())
  verificationId String
  fromStatus     VerificationStatus?
  toStatus       VerificationStatus
  action         String
  actorId        String
  reason         String?
  createdAt      DateTime            @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  RESTORED
  ASSIGNED
  UPLOADED
  APPROVED
  REJECTED
  REQUESTED
  DOWNLOADED
  STATUS_CHANGED
  OTHER
}

// Append-only activity feed built by consuming domain events (account.* / supplier.* /
// document.* / verification.* and any future module). References entities/actors by plain
// ID only - no relations to the frozen models. metadata (ActivityMetadata) is the raw
// event payload.
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  accountId      String?
  actorId        String?
  actorType      String
  entityType     String
  entityId       String?
  eventName      String
  activityType   ActivityType
  description    String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, entityType])
  @@index([organizationId, actorId])
  @@index([organizationId, activityType])
}

enum NotificationType {
  ACCOUNT
  SUPPLIER
  DOCUMENT
  VERIFICATION
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WEBHOOK
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A notification message projected from a consumed domain event (never emits events).
// Fans out to one NotificationRecipient per user. References frozen entities/actors by
// plain ID only.
model Notification {
  id             String               @id @default(cuid())
  organizationId String
  type           NotificationType
  priority       NotificationPriority @default(NORMAL)
  actorId        String?
  entityType     String?
  entityId       String?
  accountId      String?
  eventName      String
  title          String
  body           String
  metadata       Json?
  createdAt      DateTime             @default(now())

  recipients NotificationRecipient[]

  @@index([organizationId, createdAt])
}

// Per-user copy: read/archived state lives here (recipient isolation).
model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  recipientId    String
  organizationId String
  readAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  notification Notification           @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([notificationId, recipientId])
  @@index([organizationId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([recipientId, archivedAt])
}

// Per-channel delivery record. In-app is delivered immediately; email/webhook/push are
// queued for a future dispatcher (interface only).
model NotificationDelivery {
  id             String              @id @default(cuid())
  recipientRowId String
  channel        NotificationChannel
  status         NotificationStatus  @default(QUEUED)
  attemptedAt    DateTime?
  deliveredAt    DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  recipient NotificationRecipient @relation(fields: [recipientRowId], references: [id], onDelete: Cascade)

  @@index([recipientRowId])
}

// Per user, per notification type. Missing row = default (enabled, in-app).
model NotificationPreference {
  id             String                @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  enabled        Boolean               @default(true)
  muted          Boolean               @default(false)
  digest         Boolean               @default(false)
  channels       NotificationChannel[]
  updatedAt      DateTime              @updatedAt

  @@unique([userId, type])
  @@index([organizationId, userId])
}

enum BuyerType {
  IMPORTER
  DISTRIBUTOR
  WHOLESALER
  RETAILER
  FOOD_PROCESSOR
  TRADER
  BRAND
  HORECA
  OTHER
}

enum ImportExperience {
  NEW
  YEARS_1_3
  YEARS_3_PLUS
}

// 1:1 buyer extension of Account. Account owns identity; BuyerProfile owns buyer demand.
// Account is FROZEN, so accountId is a plain unique reference (no Prisma relation / no
// back-relation on Account); the 1:1 is enforced by the unique key + the service.
model BuyerProfile {
  id             String @id @default(cuid())
  accountId      String @unique
  organizationId String

  businessType           BuyerType?
  annualRequirement      String?
  annualBudgetBand       String?
  importExperience       ImportExperience?
  destinationCountries   String[]
  destinationPort        String?
  incoterms              String[]
  paymentTerms           String[]
  certificationsRequired String[]
  languages              String[]

  website     String?
  socialLinks Json?
  description String?

  version     Int       @default(1)
  createdById String
  updatedById String
  deletedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  products BuyerProduct[]

  @@index([organizationId, deletedAt])
}

// A product the buyer wants to source (demand seed for EXT-01 intent modelling).
model BuyerProduct {
  id             String   @id @default(cuid())
  buyerProfileId String
  product        String
  targetVolume   String?
  targetPrice    String?
  frequency      String?
  createdAt      DateTime @default(now())

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [id], onDelete: Cascade)

  @@unique([buyerProfileId, product])
  @@index([buyerProfileId])
}

// ===========================================================================
// AUTH EXTENSION (TRY-BNP-AUTH-02)
//
// Additive layer over the FROZEN authentication foundation (TRY-BNP-AUTH-01).
// User, Role, UserRole, PasswordResetToken, Organization and AuditLog are NOT
// modified: the only touch is column-less back-relations on User and Role.
//
// Authorization logic stays in CASL (@triyara/auth). Nothing here stores a
// permission rule - these tables store identity lifecycle state and role
// ASSIGNMENTS only. CASL remains the single source of truth for what a role
// is allowed to do.
// ===========================================================================

/// What a scoped role grant applies to. Scope targets are referenced by plain
/// id, never by FK, so this table constrains neither frozen modules nor the
/// product catalog.
enum RoleScopeType {
  ORGANIZATION
  ACCOUNT
  SUPPLIER_PROFILE
  BUYER_PROFILE
  PRODUCT
  CATEGORY
}

/// Why a session stopped being valid.
enum SessionEndReason {
  LOGOUT
  EXPIRED
  REVOKED_BY_ADMIN
  PASSWORD_CHANGED
  USER_DEACTIVATED
}

/// Outcome of a single authentication attempt.
enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  USER_NOT_FOUND
  INACTIVE_USER
  LOCKED_OUT
  RATE_LIMITED
}

/// 1:1 extension of the frozen User. Holds the identity-lifecycle attributes
/// User has no column for (email verification, lockout, password age).
model UserSecurityProfile {
  id             String @id @default(cuid())
  userId         String @unique
  organizationId String

  emailVerifiedAt DateTime?

  lastPasswordChangeAt DateTime?
  failedLoginCount     Int       @default(0)
  lastFailedLoginAt    DateTime?
  /// Set by the lockout policy; a login is refused while this is in the future.
  lockedUntil          DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([lockedUntil])
  @@index([organizationId, emailVerifiedAt])
}

/// Single-use email verification token. Only the hash is stored, matching the
/// existing PasswordResetToken pattern - the plaintext never touches the row.
model EmailVerificationToken {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  /// The address being verified. Held separately from User.email so an
  /// email-change flow can verify the new address before it is adopted.
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// Registry of issued sessions. The frozen Auth.js configuration is JWT-based
/// and is not changed; this table records each issued session so it can be
/// listed, audited and revoked. Enforcement is opt-in per endpoint via
/// assertSessionActive - see ADR-0011.
model UserSession {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  /// Opaque identifier carried as the JWT `jti`. One row per issued token.
  tokenId String @unique

  ipAddress String?
  userAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  endedAt   DateTime?
  endReason SessionEndReason?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([organizationId, endedAt])
  @@index([expiresAt])
}

/// Enterprise RBAC: grants an existing Role to a user for a specific resource,
/// optionally time-boxed. Stores the ASSIGNMENT only - what the role permits is
/// decided by CASL, which stays the source of truth.
model ScopedRoleAssignment {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  roleId         String

  scopeType RoleScopeType
  /// Plain identifier; deliberately not a foreign key (see enum docs).
  scopeId   String

  grantedById String
  grantedAt   DateTime  @default(now())
  /// Null means the grant does not expire.
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  reason      String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@index([organizationId, userId, revokedAt])
  @@index([organizationId, scopeType, scopeId])
  @@index([organizationId, roleId])
  @@index([expiresAt])
}

/// Durable authentication-attempt log. The existing in-memory rate limiter is
/// per-instance; this table survives restarts and gives security review a real
/// audit trail. Email is recorded as attempted, so it is not a foreign key -
/// failed attempts for non-existent users must still be recorded.
model LoginAttempt {
  id             String  @id @default(cuid())
  email          String
  userId         String?
  organizationId String?

  outcome   LoginOutcome
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([organizationId, outcome, createdAt])
  @@index([createdAt])
}
